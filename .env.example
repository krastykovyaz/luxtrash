GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Reminder emails — all optional. Leave unset and notifications quietly
# no-op (registration still works, it just won't send anything). Works with
# any SMTP provider: a transactional-email service (Postmark, Resend's SMTP
# endpoint, Mailgun, SES) is the most reliable; Gmail SMTP + an app password
# also works but Gmail rate-limits it aggressively for anything but a handful
# of recipients.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 5-field cron, evaluated in Europe/Luxembourg time (forced at startup
# regardless of the server's own OS timezone). Default checks every day at
# 18:00 — "the evening before" — and only actually sends mail on the days
# that have a real collection tomorrow.
NOTIFY_CRON=0 18 * * *
# End-of-week "who's up next week" notice, sent to everyone. Default Sunday
# 18:00, same Europe/Luxembourg time basis as NOTIFY_CRON above.
WEEK_AHEAD_CRON=0 18 * * 0
